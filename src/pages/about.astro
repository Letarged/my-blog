---
import { SITE_TITLE } from '../consts';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
---

<html lang="en">
	<head>
		<BaseHead
			title={`About — ${SITE_TITLE}`}
			description="Penetration tester. HTB writeups, anonymised engagement findings, and security research."
		/>
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/GeistSans-400.woff2" />
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/GeistSans-600.woff2" />
	</head>
	<body>
		<SiteHeader />

		<main class="about-page" data-pagefind-ignore>

			<header class="about-header">
				<h1 class="about-name">c0rvex</h1>
				<p class="about-tagline">Penetration tester. Occasionally breaks things for a living.</p>
			</header>

			<section class="about-section">
				<h2 class="section-label">About</h2>
				<div class="section-body">
					<p>
						This site is a personal notebook — HTB machine walkthroughs posted after
						retirement, anonymised findings from real-world engagements, and short
						technical notes from the day-to-day.
					</p>
					<p>
						Everything published here is either CTF/lab-based or covers publicly-known
						vulnerabilities. Real-world content is fully anonymised: no client names,
						no internal hostnames, no identifiable infrastructure. See the
						<a href="/disclaimer">disclaimer</a> for the full responsible-disclosure policy.
					</p>
				</div>
			</section>

			<section class="about-section">
				<h2 class="section-label">Certifications</h2>
				<div class="section-body">
					<ul class="cert-list">
						<li class="cert-card">
							<span class="cert-name">OSCP</span>
							<span class="cert-issuer">Offensive Security</span>
						</li>
						<li class="cert-card">
							<span class="cert-name">CEH</span>
							<span class="cert-issuer">EC-Council</span>
						</li>
						<li class="cert-card">
							<span class="cert-name">CompTIA Security+</span>
							<span class="cert-issuer">CompTIA</span>
						</li>
					</ul>
				</div>
			</section>

			<section class="about-section">
				<h2 class="section-label">HackTheBox</h2>
				<div class="section-body">
					<p>
						Active on HackTheBox — Hacker rank. Writeups for retired machines are
						published here once the official walkthrough is released.
					</p>
					<a href="https://app.hackthebox.com/profile/" class="external-link" target="_blank" rel="noopener noreferrer">
						HTB Profile
						<svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path d="M2 2h8M10 2v8M10 2L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
						</svg>
					</a>
				</div>
			</section>

			<section class="about-section">
				<h2 class="section-label">LinkedIn</h2>
				<div class="section-body">
					<a href="https://linkedin.com/in/" class="external-link" target="_blank" rel="noopener noreferrer">
						Connect on LinkedIn
						<svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path d="M2 2h8M10 2v8M10 2L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
						</svg>
					</a>
				</div>
			</section>

			<section class="about-section">
				<h2 class="section-label">What I Work On</h2>
				<div class="section-body">
					<ul class="work-list">
						<li>Web application penetration testing</li>
						<li>Network and infrastructure assessments</li>
						<li>Active Directory and Windows environment attacks</li>
						<li>Red team operations and adversary simulation</li>
						<li>Vulnerability research and CVE analysis</li>
					</ul>
				</div>
			</section>

			<section class="about-section">
				<h2 class="section-label">Current Status</h2>
				<div class="section-body">
					<p>
						Available for freelance engagements and consulting. Currently focused on
						Active Directory attack paths and cloud security research. See
						<a href="/now">/now</a> for what I'm working on this month.
					</p>
				</div>
			</section>

			<section class="about-section">
				<h2 class="section-label">PGP</h2>
				<div class="section-body">
					<p class="pgp-note">
						For encrypted communication, my public key is available on
						<a href="https://keys.openpgp.org" target="_blank" rel="noopener noreferrer">keys.openpgp.org</a>.
					</p>
				</div>
			</section>

		</main>

		<SiteFooter />
	</body>
</html>

<style>
	.about-page {
		max-width: 68ch;
		margin-inline: auto;
		padding: 3rem 1.5rem 6rem;
	}

	/* ── Header ── */
	.about-header {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}

	.about-name {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		color: var(--text);
		margin: 0 0 0.5rem;
	}

	.about-tagline {
		font-size: 1rem;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.5;
	}

	/* ── Sections ── */
	.about-section {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
	}

	.section-label {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
		margin: 0;
	}

	.section-body p {
		font-size: 0.9375rem;
		color: var(--text-muted);
		line-height: 1.7;
		margin: 0 0 0.75rem;
	}

	.section-body p:last-child {
		margin-bottom: 0;
	}

	.section-body a {
		color: var(--accent);
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.section-body a:hover {
		color: var(--accent-hover);
	}

	/* ── Cert cards ── */
	.cert-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.cert-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: 0.625rem 0.875rem;
	}

	.cert-name {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text);
	}

	.cert-issuer {
		font-size: 0.8125rem;
		color: var(--text-faint);
	}

	/* ── Work list ── */
	.work-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.work-list li {
		font-size: 0.9375rem;
		color: var(--text-muted);
		padding-left: 1rem;
		position: relative;
		line-height: 1.6;
	}

	.work-list li::before {
		content: '›';
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	/* ── External link ── */
	.external-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.8125rem;
		color: var(--accent);
		text-decoration: none;
		transition: color 150ms var(--ease-out);
	}

	.external-link:hover {
		color: var(--accent-hover);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ── PGP ── */
	.pgp-note {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.8125rem;
	}

	/* ── Desktop: two-column section layout ── */
	@media (min-width: 768px) {
		.about-section {
			grid-template-columns: 10rem 1fr;
			gap: 0 2rem;
			align-items: start;
		}

		.section-label {
			padding-top: 0.125rem; /* optical alignment with first line of body */
		}
	}

	@media (min-width: 1024px) {
		.about-page {
			max-width: calc(10rem + 2rem + 68ch);
			padding: 4rem 2rem 6rem;
		}
	}
</style>
