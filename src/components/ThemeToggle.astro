---
// Theme toggle button — CSS handles icon visibility via [data-theme] selectors.
// theme-toggle.js manages aria-pressed and the click event.
// No <script> here: theme-init.js (blocking) sets data-theme before paint;
// theme-toggle.js (deferred) wires the click handler after DOM is ready.
---

<button
	type="button"
	id="theme-toggle"
	class="theme-toggle"
	aria-label="Toggle light/dark theme"
	aria-pressed="false"
>
	<!-- Sun icon: shown in dark mode (clicking switches to light) -->
	<svg class="icon icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none"
		 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
		 aria-hidden="true">
		<circle cx="12" cy="12" r="4"/>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
	</svg>
	<!-- Moon icon: shown in light mode (clicking switches to dark) -->
	<svg class="icon icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none"
		 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
		 aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
	</svg>
</button>

<style>
	.theme-toggle {
		all: unset;
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
		cursor: pointer;
		color: var(--text-muted);
		border-radius: var(--radius-md);
		transition: color 150ms var(--ease-out);
		flex-shrink: 0;
	}

	.theme-toggle:hover {
		color: var(--text);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* ── Icon visibility (CSS-driven, no flash) ── */

	/* Default (before JS sets data-theme): dark is canonical, show sun */
	.icon-sun  { display: block; }
	.icon-moon { display: none; }

	/* Dark mode: show sun (user can switch to light) */
	:global(html[data-theme="dark"]) .icon-sun  { display: block; }
	:global(html[data-theme="dark"]) .icon-moon { display: none; }

	/* Light mode: show moon (user can switch to dark) */
	:global(html[data-theme="light"]) .icon-sun  { display: none; }
	:global(html[data-theme="light"]) .icon-moon { display: block; }
</style>
