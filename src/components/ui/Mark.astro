---
// Typographic site mark — ❯_ glyph in JetBrains Mono
// Reads as a terminal cursor prompt: the site's identity in two characters.
---

<a href="/" class="mark" aria-label="Home">
	<span class="mark__glyph" aria-hidden="true">❯_</span><span class="mark__name">c0rvex</span>
</a>

<style>
	.mark {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-weight: 600;
		font-size: 1.125rem;
		color: var(--accent);
		letter-spacing: -0.05em;
		text-decoration: none;
		line-height: 1;
		transition: color 150ms var(--ease-out);
		display: flex;
		align-items: baseline;
		gap: 0.5ch;
	}

	.mark:hover {
		color: var(--accent-hover);
		text-decoration: none;
	}

	.mark__name {
		font-weight: 700;
		letter-spacing: -0.03em;
	}
</style>
