---
import Mark from './Mark.astro';
import SearchBar from '../SearchBar.astro';
import ThemeToggle from '../ThemeToggle.astro';

// Determine active nav item from current path
const path = Astro.url.pathname;
const isWriteups = path.startsWith('/writeups');
const isFindings = path.startsWith('/findings');
const isNotes    = path.startsWith('/notes') || path.startsWith('/tags');
---

<!-- data-pagefind-ignore: prevent nav chrome from polluting the search index -->
<header class="site-header" data-pagefind-ignore>
	<!-- Left slot: used by PostLayout to inject the mobile sidebar hamburger -->
	<div class="header-left">
		<slot name="header-left" />
		<Mark />
	</div>

	<div class="header-right">
		<nav class="site-nav" aria-label="Main navigation">
			<a href="/writeups"
				class:list={['nav-link', { active: isWriteups }]}
				aria-current={isWriteups ? 'page' : undefined}
			>writeups</a>
			<span class="nav-dot" aria-hidden="true">·</span>
			<a href="/findings"
				class:list={['nav-link', { active: isFindings }]}
				aria-current={isFindings ? 'page' : undefined}
			>findings</a>
			<span class="nav-dot" aria-hidden="true">·</span>
			<a href="/notes"
				class:list={['nav-link', { active: isNotes }]}
				aria-current={isNotes ? 'page' : undefined}
			>notes</a>
		</nav>

		<button
			type="button"
			id="search-trigger"
			class="search-trigger"
			aria-label="Open search"
			aria-keyshortcuts="Control+K Meta+K"
		>
			<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
				<path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			</svg>
			<span class="search-text">Search</span>
			<kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
		</button>

		<ThemeToggle />
	</div>
</header>

<!-- Dialog lives outside the sticky header so ::backdrop covers the full viewport -->
<SearchBar />

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 2rem;
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		background: var(--bg);
		z-index: 10;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-dot {
		color: var(--text-faint);
		font-size: 1rem;
		line-height: 1;
		user-select: none;
	}

	.nav-link {
		font-family: 'Geist Sans', system-ui, sans-serif;
		font-size: 1rem;
		font-weight: 400;
		color: var(--text-muted);
		text-decoration: none;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
		transition: color 150ms var(--ease-out), text-decoration-color 150ms var(--ease-out);
	}

	.nav-link:hover {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--border);
	}

	.nav-link.active {
		color: var(--accent);
	}

	/* ── Search trigger ── */
	.search-trigger {
		all: unset;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		cursor: pointer;
		font-family: 'Geist Sans', system-ui, sans-serif;
		font-size: 0.8125rem;
		color: var(--text-muted);
		padding: 0.3125rem 0.625rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		transition: color 150ms var(--ease-out), border-color 150ms var(--ease-out);
		white-space: nowrap;
		line-height: 1.4;
	}

	.search-trigger:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	.search-trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.search-kbd {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.625rem;
		color: var(--text-faint);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 3px;
		padding: 0.15em 0.4em;
		line-height: 1.5;
	}

	/* Hide keyboard hint on touch devices */
	@media (pointer: coarse) {
		.search-kbd {
			display: none;
		}
	}

	/* On very narrow viewports, hide the text label too */
	@media (max-width: 400px) {
		.search-text {
			display: none;
		}
	}
</style>

<script>
	// ── Trigger button ──────────────────────────────────────────────────────────
	document.getElementById('search-trigger')?.addEventListener('click', () => {
		document.dispatchEvent(new CustomEvent('search:open'));
	});

	// ── Keyboard shortcut: ⌘K (macOS) / Ctrl+K (other) ───────────────────────
	document.addEventListener('keydown', (e: KeyboardEvent) => {
		const target = e.target as HTMLElement;
		if (
			target.tagName === 'INPUT' ||
			target.tagName === 'TEXTAREA' ||
			target.tagName === 'SELECT' ||
			target.isContentEditable
		) return;

		if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
			e.preventDefault();
			// In dev mode Pagefind index doesn't exist — dispatch anyway,
			// SearchBar will show the dev notice instead of an error.
			document.dispatchEvent(new CustomEvent('search:open'));
		}
	});

	// ── Platform-appropriate shortcut label ───────────────────────────────────
	const isMac = /Mac/i.test(navigator.platform ?? '');
	if (!isMac) {
		const kbd = document.querySelector<HTMLElement>('.search-kbd');
		if (kbd) kbd.textContent = 'Ctrl+K';
	}
</script>
