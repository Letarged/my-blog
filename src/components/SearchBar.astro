---
// SearchBar — full-page search modal powered by Pagefind.
// Loaded on every page via SiteHeader. Opens in response to the
// 'search:open' custom event dispatched by the trigger button and ⌘K shortcut.
// In dev mode (no pagefind index built yet) it shows a friendly notice instead
// of throwing an uncaught error.
---

<dialog id="search-dialog" aria-label="Site search">
	<div class="search-panel">

		<div class="search-header">
			<span class="search-label">Search</span>
			<button type="button" id="search-close-btn" class="search-close" aria-label="Close search">
				<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
				</svg>
			</button>
		</div>

		<div class="search-body">
			<div id="pagefind-search"></div>
			<p id="search-dev-notice" hidden class="dev-notice">
				Search index not found — run <code>npm run build</code> to generate it.
			</p>
		</div>

	</div>
</dialog>

<style>
	/* ── Dialog shell ── */
	dialog {
		position: fixed;
		inset: 0;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
		/* Hidden state: display: none via UA sheet; shown when [open] */
	}

	dialog[open] {
		display: grid;
		place-items: start center;
		padding-top: 8vh;
	}

	:global(#search-dialog::backdrop) {
		background: rgba(0, 0, 0, 0.55);
	}

	:global(html[data-theme="light"] #search-dialog::backdrop) {
		background: rgba(26, 26, 26, 0.30);
	}

	/* ── Panel ── */
	.search-panel {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.10);
		width: min(580px, calc(100vw - 2rem));
		max-height: 78vh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	/* ── Header row ── */
	.search-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem 0.75rem 1.25rem;
		border-bottom: 1px solid var(--border);
		flex-shrink: 0;
	}

	.search-label {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		user-select: none;
	}

	.search-close {
		all: unset;
		width: 1.5rem;
		height: 1.5rem;
		display: grid;
		place-items: center;
		color: var(--text-muted);
		cursor: pointer;
		border-radius: var(--radius-sm);
		transition: color 150ms var(--ease-out);
	}

	.search-close:hover  { color: var(--text-primary); }
	.search-close:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* ── Scrollable body ── */
	.search-body {
		padding: 1rem 1.25rem;
		overflow-y: auto;
		flex: 1;
		min-height: 0;
	}

	/* ── Dev notice ── */
	.dev-notice {
		font-size: 0.875rem;
		color: var(--text-muted);
		text-align: center;
		padding: 1.5rem 0;
		margin: 0;
		line-height: 1.6;
	}

	.dev-notice code {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.85em;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.1em 0.4em;
	}

	/* ── Pagefind UI CSS variable overrides ── */
	/* Map our runtime design tokens onto Pagefind's theming system. */
	#pagefind-search {
		--pagefind-ui-scale: 0.875;
		--pagefind-ui-primary:             var(--accent);
		--pagefind-ui-text:                var(--text);
		--pagefind-ui-background:          var(--bg);
		--pagefind-ui-border:              var(--border);
		--pagefind-ui-tag:                 var(--surface);
		--pagefind-ui-border-width:        1px;
		--pagefind-ui-border-radius:       4px;
		--pagefind-ui-image-border-radius: 4px;
		--pagefind-ui-font: 'Geist Sans', system-ui, sans-serif;
	}

	/* Patch styles Pagefind doesn't expose through variables */
	:global(.pagefind-ui__search-input) {
		font-family: 'Geist Sans', system-ui, sans-serif !important;
		background: var(--bg) !important;
		color: var(--text) !important;
	}

	:global(.pagefind-ui__result-link) {
		font-weight: 600 !important;
	}

	:global(.pagefind-ui__result-excerpt mark) {
		background: var(--accent-soft) !important;
		color: var(--accent-hover) !important;
	}
</style>

<script>
	const dialog  = document.getElementById('search-dialog') as HTMLDialogElement;
	const closeBtn = document.getElementById('search-close-btn') as HTMLButtonElement;
	const devNotice = document.getElementById('search-dev-notice') as HTMLParagraphElement;

	let initialized = false;

	async function initPagefind(): Promise<void> {
		if (initialized) return;
		initialized = true;

		// Pagefind UI is a post-build artifact in dist/pagefind/.
		// Load it via <script>/<link> injection so the bundler never sees it.
		try {
			await Promise.all([
				// Stylesheet
				new Promise<void>((res, rej) => {
					const link = document.createElement('link');
					link.rel  = 'stylesheet';
					link.href = '/pagefind/pagefind-ui.css';
					link.onload = () => res();
					link.onerror = () => rej();
					document.head.appendChild(link);
				}),
				// JS — sets window.PagefindUI
				new Promise<void>((res, rej) => {
					const script  = document.createElement('script');
					script.src    = '/pagefind/pagefind-ui.js';
					script.onload  = () => res();
					script.onerror = () => rej();
					document.head.appendChild(script);
				}),
			]);

			new (window as unknown as { PagefindUI: new (opts: object) => void }).PagefindUI({
				element: '#pagefind-search',
				showImages: false,
				excerptLength: 15,
				resetStyles: false,
			});
		} catch {
			// Dev mode, or build hasn't been run yet
			devNotice.hidden = false;
		}
	}

	function openSearch(): void {
		dialog.showModal();
		void initPagefind();
		// Focus the search input after Pagefind renders it
		setTimeout(() => {
			dialog
				.querySelector<HTMLInputElement>('.pagefind-ui__search-input, input[type="text"]')
				?.focus();
		}, 60);
	}

	function closeSearch(): void {
		dialog.close();
		// Return focus to the trigger so keyboard users aren't stranded
		document.getElementById('search-trigger')?.focus();
	}

	closeBtn.addEventListener('click', closeSearch);

	// Close when user clicks the backdrop (the dialog element itself, not the panel)
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) closeSearch();
	});

	// Opened by the trigger button and ⌘K shortcut in SiteHeader
	document.addEventListener('search:open', openSearch);
</script>
