---
// Used as a <pre> component override via <Content components={{ pre: CodeBlock }} />.
// Shiki passes: class, style (bg colour), data-language on the <pre>.
// When used directly: lang, title, filename props are also accepted.
//
// Design: accent-soft bg + accent left border. No copy button chrome.
// If filename is provided, render a plain label ABOVE the block.

interface Props {
	lang?: string;
	title?: string;
	filename?: string;
	caption?: string;
	class?: string;
	'data-language'?: string;
	style?: string;
	[key: string]: unknown;
}

const {
	lang,
	title,
	filename,
	caption,
	class: className,
	'data-language': dataLang,
	// intentionally drop `style` — Shiki injects a bg colour we override in CSS
} = Astro.props;

const displayFilename = filename ?? title;
const displayLang     = lang ?? dataLang;
---

<div class="codeblock">
	{displayFilename && (
		<p class="codeblock__filename">{displayFilename}</p>
	)}
	<pre class={className} data-lang={displayLang ?? undefined}><slot /></pre>
	{caption && (
		<p class="codeblock__caption">{caption}</p>
	)}
</div>

<style>
	.codeblock {
		margin: 1.75rem 0;
	}

	.codeblock__filename {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.75rem;
		color: var(--text-muted);
		margin: 0 0 0.25rem;
		padding: 0;
	}

	.codeblock__caption {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.75rem;
		color: var(--text-faint);
		text-align: center;
		margin: 0.5rem 0 0;
		padding: 0;
	}

	/* Override Shiki's inline style — all blocks use our surface theme */
	.codeblock pre,
	.codeblock pre.astro-code {
		background: var(--surface) !important;
		border-left: 3px solid var(--accent);
		border-radius: var(--radius-md);
		padding: 1.25rem 1.5rem;
		overflow-x: auto;
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
	}
</style>
